# RSH Technik Lager System
# Hinweis: <Directory>-Blöcke sind in .htaccess-Dateien nicht erlaubt
# (nur in der Apache-Hauptkonfiguration) und wurden daher entfernt.
# Der Schutz von includes/ und sql/ erfolgt über jeweils eigene
# .htaccess-Dateien in diesen Ordnern.

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
