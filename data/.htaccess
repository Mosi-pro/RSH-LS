# Die SQLite-Datenbankdatei liegt hier. Direktzugriff über den Browser
# muss unbedingt verhindert werden, sonst könnte die komplette Datenbank
# heruntergeladen werden.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
